APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

OWNER_NAME="Mi Biblioteca"
OWNER_EMAIL=
OWNER_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mibiblio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The Google Books key. Without it the fallback works all the same, but it
# shares a global quota that returns HTTP 429 once exhausted.
GOOGLE_BOOKS_API_KEY=

# The milliseconds without keystrokes after which the intake registers on its
# own, for the Scanners that do not send Enter at the end of the code.
INTAKE_IDLE_MS=600

# The API key of each AI Provider that may write Categories and Descriptions.
# Which Provider and which AiModel get used is chosen on a screen and stored in
# the database; only the keys live here (ADR-006).
GEMINI_API_KEY=

# How many requests a minute leave for the AI provider. The default is the free
# tier's; with billing on, this is the one line that has to go up. Anything the
# provider refuses for a moment —a 429, a 503, a timeout— goes back to the queue
# with a growing wait and never lands in failed_jobs (BIB-33).
AI_REQUESTS_PER_MINUTE=5
