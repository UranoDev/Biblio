includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # The trait is used by resources/views/pages/settings/profile, which
        # phpstan does not analyse because it is Blade. It lost its PHP consumer
        # when BIB-3 deleted CreateNewUser. It is not dead code: the sibling
        # trait PasswordValidationRules does not raise this error only because
        # ResetUserPassword -- a PHP file -- uses it too.
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php

        # Same thing: RegeneratesBooks is used by the Shelf grid and by the
        # Book sheet, and both are Blade. The trait exists precisely so that
        # those two screens press the same button (BIB-22), so its only
        # consumers are files phpstan does not read.
        -
            identifier: trait.unused
            path: app/Concerns/RegeneratesBooks.php
